# FastAPI Backend - Environment Variables Template
# Copy this file to backend/.env and replace placeholders with local/cloud credentials.
# NEVER commit the real .env file.

ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
API_V1_STR=/api/v1
PROJECT_NAME="SafeSettle API"

# Allowed CORS Origins (comma-separated)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database Connection (Direct PostgreSQL connection to Supabase or local PostGIS instance)
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Supabase Auth & Storage API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
