# SafeSettle - Environment Variables Template
# Copy this file to .env and configure with your project credentials.
# NEVER commit the real .env file to version control.

# Application Environment
ENVIRONMENT=development
APP_NAME=SafeSettle-MVP

# Supabase Project Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# PostgreSQL Direct Connection (PostGIS enabled)
# Used by backend services and database migration tools
# Format: postgresql://[user]:[password]@[host]:[port]/[dbname]
DATABASE_URL=postgresql://postgres:your-db-password@db.your-project-id.supabase.co:5432/postgres

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend Configuration
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api/v1
