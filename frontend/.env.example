# React Frontend - Environment Variables Template
# Copy this file to frontend/.env and replace placeholders.
# NEVER commit the real .env file.

VITE_APP_TITLE="SafeSettle - Disaster Relocation Decision Support"
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Supabase Client Configuration (Public Anon Key only, NEVER expose service role key here)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
